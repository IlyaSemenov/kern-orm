{
  "extends": "@tsconfig/bun",
  "compilerOptions": {
    "types": ["bun"],
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    // Resolve workspace packages to their sources in tests, examples, and typecheck without building them.
    "paths": {
      "kern-db": ["./packages/db/src/index.ts"],
      "kern-db/builder": ["./packages/db/src/builder.ts"],
      "kern-db/node-postgres": ["./packages/db/src/node-postgres.ts"],
      "kern-db/postgres-js": ["./packages/db/src/postgres-js.ts"],
      "kern-db/testing": ["./packages/db/src/testing.ts"],
      "kern-db/types": ["./packages/db/src/types.ts"],
      "kern-migrations": ["./packages/migrations/src/index.ts"],
      "kern-migrations/cli": ["./packages/migrations/src/cli.ts"],
      "kern-migrations/testing": ["./packages/migrations/src/testing.ts"],
      "kern-orm": ["./packages/orm/src/index.ts"],
      "kern-orm/testing": ["./packages/orm/src/testing.ts"],
      "kern-orm/types": ["./packages/orm/src/types.ts"],
      "kern-orm/db": ["./packages/orm/src/db.ts"],
      "kern-orm/db/node-postgres": ["./packages/orm/src/db/node-postgres.ts"],
      "kern-orm/db/postgres-js": ["./packages/orm/src/db/postgres-js.ts"],
      "kern-orm/db/types": ["./packages/orm/src/db/types.ts"],
      "@kern-orm/test-harness/errors": ["./testing/errors.ts"],
      "@kern-orm/test-harness/postgres": ["./testing/postgres.ts"],
      "@kern-orm/test-harness/recording-driver": ["./testing/recording-driver.ts"]
    }
  },
  "include": [
    "*.ts",
    "docs/.vitepress/**/*.ts",
    "packages/*/*.ts",
    "packages/*/src/**/*.ts",
    "packages/*/testing/**/*.ts",
    "packages/*/tests/**/*.ts",
    "examples/*/src/**/*.ts",
    "examples/*/testing/**/*.ts",
    "examples/*/tests/**/*.ts",
    "testing/**/*.ts",
    "benchmarks/**/*.ts"
  ],
  // The package test type-checks its consumer fixtures against the packed packages.
  "exclude": ["packages/*/tests/package/fixtures"]
}
