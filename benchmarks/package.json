{
  "name": "@kern-orm/benchmarks",
  "version": "0.0.0",
  "private": true,
  "description": "Benchmarks of the SQL that kern-orm builds, the time of its JavaScript, and the type-check cost of its API",
  "type": "module",
  "scripts": {
    "bench": "bun --env-file=../.env.test.local run.ts",
    "bench:runtime": "bun run --cwd .. build && bun runtime/run.ts",
    "bench:types": "bun run --cwd .. build && node types/run.ts",
    "profile:types": "bun run --cwd .. build && bun types/profile.ts"
  },
  "devDependencies": {
    "@ark/attest": "^0.58.0",
    "@kern-orm/postgres-js": "workspace:*",
    "@types/pg": "catalog:",
    "kern-orm": "workspace:*",
    "mitata": "^1.0.34",
    "pg": "catalog:",
    "postgres": "catalog:",
    "typescript-6": "catalog:"
  }
}
