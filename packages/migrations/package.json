{
  "name": "kern-migrations",
  "version": "0.3.0",
  "description": "Migrations of PostgreSQL schemas for kern-db and kern-orm",
  "keywords": [
    "kern-db",
    "kern-orm",
    "migrations",
    "postgres",
    "postgresql",
    "schema"
  ],
  "homepage": "https://ilyasemenov.github.io/kern-orm/",
  "bugs": "https://github.com/IlyaSemenov/kern-orm/issues",
  "license": "MIT",
  "author": "Ilya Semenov",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/IlyaSemenov/kern-orm.git",
    "directory": "packages/migrations"
  },
  "files": [
    "README.md",
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "types": "./dist/index.d.mts",
  "exports": {
    ".": "./dist/index.mjs",
    "./cli": "./dist/cli.mjs",
    "./testing": "./dist/testing.mjs",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "prepublishOnly": "bun run build"
  },
  "devDependencies": {
    "kern-db": "workspace:*",
    "kern-orm": "workspace:*",
    "postgres": "catalog:"
  },
  "peerDependencies": {
    "kern-db": "^0.2.0"
  },
  "engines": {
    "bun": ">=1.4",
    "node": ">=24"
  }
}
