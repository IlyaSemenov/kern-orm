{
  "name": "kern-orm",
  "version": "0.12.0",
  "description": "Fully typed relational query builder for PostgreSQL with ambient transactions and single-query relation loading",
  "keywords": [
    "orm",
    "postgres",
    "postgresql",
    "query-builder",
    "sql",
    "transactions",
    "typescript"
  ],
  "homepage": "https://ilyasemenov.github.io/kern-orm/",
  "bugs": "https://github.com/IlyaSemenov/kern-orm/issues",
  "license": "MIT",
  "author": "Ilya Semenov",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/IlyaSemenov/kern-orm.git",
    "directory": "packages/orm"
  },
  "files": [
    "README.md",
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "types": "./dist/index.d.mts",
  "exports": {
    ".": "./dist/index.mjs",
    "./db": "./dist/db.mjs",
    "./db/node-postgres": "./dist/db/node-postgres.mjs",
    "./db/postgres-js": "./dist/db/postgres-js.mjs",
    "./db/types": "./dist/db/types.mjs",
    "./testing": "./dist/testing.mjs",
    "./types": "./dist/types.mjs",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "prepublishOnly": "bun run build"
  },
  "dependencies": {
    "kern-db": "^0.3.0"
  },
  "devDependencies": {
    "@kern-orm/test-harness": "workspace:*",
    "postgres": "catalog:",
    "typescript-6": "catalog:"
  },
  "engines": {
    "bun": ">=1.4",
    "node": ">=24"
  }
}
