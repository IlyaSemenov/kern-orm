    "kern-migrations": "workspace:*",
    "kern-orm": "workspace:*",
    "orchid-orm": "1.78.61",
    "postgres": "catalog:"
  },
  "peerDependencies": {
    "kern-db": "^0.9.0",
    "orchid-orm": "^1.78.61",
    "postgres": "^4.0.0"
  },
  "engines": {
    "bun": ">=1.4",
    "node": ">=24"
  }
