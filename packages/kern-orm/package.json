{
  "name": "kern-orm",
  "version": "0.5.0",
  "description": "Fully typed relational query builder for PostgreSQL with ambient transactions and single-query relation loading",
  "keywords": [
    "orm",
    "postgres",
    "postgresql",
    "query-builder",
    "sql",
    "transactions",
    "typescript"
  ],
  "homepage": "https://ilyasemenov.github.io/kern-orm/",
  "bugs": "https://github.com/IlyaSemenov/kern-orm/issues",
  "license": "MIT",
  "author": "Ilya Semenov",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/IlyaSemenov/kern-orm.git",
    "directory": "packages/kern-orm"
  },
  "files": [
    "README.md",
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "types": "./dist/index.d.mts",
  "exports": {
    ".": "./dist/index.mjs",
    "./testing": "./dist/testing.mjs",
    "./types": "./dist/types.mjs",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "prepublishOnly": "bun run build"
  },
  "devDependencies": {
    "@kern-orm/postgres-js": "workspace:*",
    "kern-orm-0.2.0": "https://registry.npmjs.org/kern-orm/-/kern-orm-0.2.0.tgz",
    "kern-orm-0.3.0": "https://registry.npmjs.org/kern-orm/-/kern-orm-0.3.0.tgz",
    "migrations-published": "https://registry.npmjs.org/@kern-orm/migrations/-/migrations-0.3.1.tgz",
    "node-postgres-published": "https://registry.npmjs.org/@kern-orm/node-postgres/-/node-postgres-0.1.0.tgz",
    "postgres": "catalog:",
    "postgres-js-published": "https://registry.npmjs.org/@kern-orm/postgres-js/-/postgres-js-0.1.2.tgz",
    "postgres-js-v3-published": "https://registry.npmjs.org/@kern-orm/postgres-js-v3/-/postgres-js-v3-0.1.2.tgz",
    "typescript-6": "catalog:"
  },
  "engines": {
    "bun": ">=1.4",
    "node": ">=24"
  }
}
